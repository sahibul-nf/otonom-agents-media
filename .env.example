# Shared Autonomous Media Engine environment
# Copy to .env.local or a deployment secret store. Never commit real values.

NODE_ENV=development
TZ=Asia/Jakarta

# LLM providers
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_STATUS_CHAT_ID=
TELEGRAM_STATUS_THREAD_ID=

# Path A — Cursor Automation / Cloud Agents (manual Generate via Cursor)
# CURSOR_API_KEY=                    # required to poll run status
# CURSOR_AUTOMATION_WEBHOOK_URL=     # preferred trigger (HeyGen MCP on Automation)
# CURSOR_AUTOMATION_WEBHOOK_TOKEN=   # Bearer crsr_… (falls back to CURSOR_API_KEY)
# CURSOR_API_BASE=https://api.cursor.com
# CURSOR_PATH_A_TIMEOUT_SECONDS=1800
# CURSOR_PATH_A_POLL_INTERVAL_SECONDS=15
# CURSOR_API_DRY_RUN=0
# CURSOR_DRY_RUN_VIDEO_URL=

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
NOURBIT_FACEBOOK_PAGE_ID=
NOURBIT_FACEBOOK_PAGE_TOKEN=
NOURBIT_INSTAGRAM_BUSINESS_ACCOUNT_ID=
NOURBIT_INSTAGRAM_ACCESS_TOKEN=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
NOURBIT_YOUTUBE_CHANNEL_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
NOURBIT_TIKTOK_ACCOUNT=@nourbit.clips

# Render tools. HyperFrames is the primary renderer; enable after doctor/lint/render smoke pass locally.
HYPERFRAMES_ENABLED=false
REMOTION_ENABLED=false

# HeyGen (Phase 2 Direct API — optional; Phase 0 uses Creator+MCP fixtures only)
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_LOOK_ID=0f4dca86e0bd42d8a8afdae9948338ce
# HEYGEN_VOICE_ID=LXpG1p9h8viifHEGQiFJ
# HEYGEN_ENGINE=avatar_iii

# PM2 / local ops
MEDIA_ENGINE_PORT=8765
DASHBOARD_PORT=3100
PM2_HEALTH_INTERVAL_SECONDS=60
# Isolated worktree: MEDIA_ENGINE_PORT=8766 DASHBOARD_PORT=3101
# MEDIA_ENGINE_DB=/absolute/path/media_engine.dev.sqlite
# MEDIA_ENGINE_ARTIFACTS=/absolute/path/artifacts-dev

# Optional: Netscape cookies.txt for YouTube downloads when CDN returns HTTP 403
# MEDIA_ENGINE_YTDLP_COOKIES=/absolute/path/to/cookies.txt
